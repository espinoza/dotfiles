#!/bin/bash

# Based on https://gitlab.com/gabmus/mydotfiles/-/blob/master/util/makelinks


# Install dotfiles from wherever this repo is cloned

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Replace a symlink with a link to the repo; back up real files and folders
link() {
	local target="$1" source="$2"
	if [ -L "$target" ]; then
		rm "$target"
	elif [ -e "$target" ]; then
		mv "$target" "$target.bak-$(date +%Y%m%d%H%M%S)"
		echo "  backed up existing $target"
	fi
	ln -s "$source" "$target"
}

# Neovim 0.12+ (plugins install themselves on first start with vim.pack)
echo "Installing Neovim config..."
mkdir -p "$HOME/.config"
link "$HOME/.config/nvim" "$DOTFILES/.config/nvim"

echo "Ready."

#!/bin/bash

# Run bin/theme whenever GNOME switches between dark and light style.
# Started at login by the theme-follow-gnome systemd user service.

THEME="$(dirname "$(readlink -f "$0")")/theme"

apply() {
	case "$1" in
		*prefer-dark*) "$THEME" dark ;;
		*) "$THEME" light ;;
	esac
}

apply "$(gsettings get org.gnome.desktop.interface color-scheme)"
gsettings monitor org.gnome.desktop.interface color-scheme | while read -r line; do
	apply "$line"
done
